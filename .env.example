# =============================================================================
# Antigravity Node.js - Environment Configuration Template
# =============================================================================
# Copy this file to .env and populate with your environment-specific credentials.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# MongoDB Connection Strings
# -----------------------------------------------------------------------------
# Primary cluster connection (Multi-tenant pool with 1,200+ databases)
MONGO_URI=mongodb://<username>:<password>@<host>:<port>

# Secondary / Specialized Cluster URIs
SEMRUSH_MONGO_URI=mongodb://<username>:<password>@<host>:<port>
JFR_MONGO_URI=mongodb://<username>:<password>@<host>:<port>/admin

# Local cluster fallback (Optional: set LOCAL_DOMAIN_MONGOS=true for local dev)
LOCAL_DOMAIN_MONGOS=false
BANANA_MONGO_URI=mongodb://localhost:27017

# -----------------------------------------------------------------------------
# Google Cloud / Google Sheets API
# -----------------------------------------------------------------------------
# Path to service account credentials JSON file (gitignored)
GOOGLE_CREDENTIALS=credentials.json
GOOGLE_APPLICATION_CREDENTIALS=credentials.json
PROJECT_ID=your-gcp-project-id

# Google Sheets Target IDs for Automated Reporting
JOBGET_GOOGLE_SHEET_ID=your_jobget_spreadsheet_id_here
WHATJOBS_SPREADSHEET_ID=your_whatjobs_spreadsheet_id_here

# -----------------------------------------------------------------------------
# SMTP Email Notifications (Alerts & Reports)
# -----------------------------------------------------------------------------
SMTP_USER=alerts@example.com
SMTP_PASS=your_app_password
SMTP_SENDER=alerts@example.com
SMTP_RECEIVER=team-lead@example.com
SMTP_CC=operations@example.com

# -----------------------------------------------------------------------------
# Operational APIs
# -----------------------------------------------------------------------------
IS_REMOTE_API_URL=http://<host>:<port>/update_is_remote

# Optional domain mapping for non-.com domains (JSON format)
# Example: {"custom_tenant_prod":"custom-tenant.org"}
DOMAIN_API_MAP={}

# -----------------------------------------------------------------------------
# LLM & AI Acceleration (Optional)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# -----------------------------------------------------------------------------
# Application Runtime
# -----------------------------------------------------------------------------
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
